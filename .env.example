# Public settings only. Never put secret keys in this file: everything here is shipped to the browser.
VITE_SITE_URL=https://orridan.net
VITE_DASHBOARD_URL=https://client.orridan.net
# Google reCAPTCHA v2 checkbox SITE key (public). The secret goes in api/config.php on the server.
VITE_RECAPTCHA_SITE_KEY=
# Optional third-party chat provider, loaded only after consent. Use none to disable.
VITE_CHAT_PROVIDER=none
# Stripe TEST-MODE Payment Links (https://buy.stripe.com/test_...). Leave empty to disable a button.
VITE_STRIPE_LINK_ORGANISATION_MONTHLY=
VITE_STRIPE_LINK_ORGANISATION_ANNUAL=
VITE_STRIPE_LINK_TWIN_MONTHLY=
VITE_STRIPE_LINK_TWIN_ANNUAL=
VITE_STRIPE_LINK_ENTERPRISE_MONTHLY=
VITE_STRIPE_LINK_ENTERPRISE_ANNUAL=
