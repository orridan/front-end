{
  "name": "orridan-frontend",
  "version": "1.0.0",
  "description": "Orridan marketing site",
  "scripts": {
    "dev": "npm run brand && vite",
    "brand": "tsx scripts/generate-brand.ts",
    "build": "npm run brand && vitest run src/lib/pricing.test.ts src/sections/Pricing.test.tsx && vite build && tsx scripts/postbuild.ts",
    "build:e2e": "npm run brand && vite build --mode e2e --outDir dist-e2e && tsx scripts/postbuild.ts dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:dashes": "tsx scripts/check-dashes.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:external": "tsx scripts/check-external.ts",
    "check:php": "tsx scripts/check-php.ts",
    "check": "npm run typecheck && npm run lint && npm run check:dashes && npm run check:placeholders && npm run test && npm run build && npm run check:links && npm run check:php",
    "e2e": "npm run build:e2e && playwright test",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "framer-motion": "^14.6.0",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "browserslist": [
    "last 2 versions",
    "Safari >= 15",
    "iOS >= 15",
    "not dead",
    "not op_mini all"
  ]
}
